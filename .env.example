# Nur Testschluessel verwenden, bis der Checkout vollstaendig geprueft wurde.
STRIPE_SECRET_KEY=sk_test_hier_eintragen
STRIPE_WEBHOOK_SECRET=whsec_hier_eintragen

# Lokal: http://localhost:3000 (oder der vom Startskript angezeigte Port)
# Live: die vollstaendige HTTPS-Adresse des Shops
SITE_URL=http://localhost:3000

# Interner Bereich unter /admin. Das Kennwort muss mindestens 12 Zeichen lang sein.
ADMIN_PASSWORD=hier_ein_sicheres_admin_kennwort_eintragen
# Mindestens 32 zufaellige Zeichen; getrennt vom Admin-Kennwort halten.
ADMIN_SESSION_SECRET=hier_mindestens_32_zufaellige_zeichen_eintragen

# Optional: automatische Bestell- und Versandbestaetigungen ueber Resend.
RESEND_API_KEY=re_hier_eintragen
ORDER_FROM_EMAIL=ROAMETRIC Shop <shop@deine-domain.de>
ORDER_REPLY_TO=hello@deine-domain.de
